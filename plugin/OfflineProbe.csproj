<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../data/packs/FairPackResources.props" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <AssemblyName>HSNativeUIProbe</AssemblyName>
    <GameReferences Condition="'$(GameReferences)' == ''">$(MSBuildThisFileDirectory)../references/game</GameReferences>
    <BepInExReferences Condition="'$(BepInExReferences)' == ''">$(MSBuildThisFileDirectory)../references/bepinex</BepInExReferences>
    <!-- Vendor mode is a maintainer convenience: a prebuilt engine at vendor/SabberStoneCore.dll, which is never tracked and not in a public export. Without one (and with no engine path given) the plugin builds the engine from source. -->
    <EngineSource Condition="'$(EngineSource)' == '' and '$(StandardProof)' != 'true' and '$(SabberStoneCorePath)' == '' and !Exists('$(MSBuildThisFileDirectory)../vendor/SabberStoneCore.dll')">true</EngineSource>
    <SabberStoneCorePath Condition="'$(SabberStoneCorePath)' == '' and '$(StandardProof)' != 'true'">$(MSBuildThisFileDirectory)../vendor/SabberStoneCore.dll</SabberStoneCorePath>
  </PropertyGroup>
  <!-- The local-network multiplayer core (docs/MULTIPLAYER.md) is the only game-side code that opens a socket. It is
       left out unless asked for with -p:Multiplayer=true, so an ordinary build holds no network code at all. -->
  <ItemGroup Condition="'$(Multiplayer)' != 'true'">
    <Compile Remove="Multiplayer/**" />
  </ItemGroup>
  <PropertyGroup Condition="'$(EngineSource)' == 'true'">
    <!-- Unity loads this engine already; net48 alone does not advertise netstandard2.1 compatibility. -->
    <DefineConstants>$(DefineConstants);ENGINE_SOURCE</DefineConstants>
    <AssetTargetFallback>$(AssetTargetFallback);netstandard2.1</AssetTargetFallback>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Installer)' == 'true'">
    <DefineConstants>$(DefineConstants);SOLOSTONE_INSTALLER;SOLOSTONE_PLUGIN</DefineConstants>
  </PropertyGroup>
  <!-- Live-test builds only: keeps test control and the lab guard. An Installer release has neither. -->
  <PropertyGroup Condition="'$(Installer)' == 'true' and '$(TestHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);SOLOSTONE_TEST_HOOKS</DefineConstants>
  </PropertyGroup>
  <!-- The public build: no test control, no lab paths, public names (I2b). Lab and live-test builds keep the lab names. -->
  <PropertyGroup Condition="'$(Installer)' == 'true' and '$(TestHooks)' != 'true'">
    <DefineConstants>$(DefineConstants);SOLOSTONE_RELEASE</DefineConstants>
  </PropertyGroup>
  <!-- Every Installer build (hook builds too) is staged as SoloStone.Plugin.dll: the launcher's payload rules name that file. -->
  <PropertyGroup Condition="'$(Installer)' == 'true'">
    <AssemblyName>SoloStone.Plugin</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(Installer)' == 'true'">
    <Compile Include="../installer/SoloStone.Launcher/Core.cs" Link="InstallerCore.cs" />
    <Compile Include="../installer/SoloStone.Launcher/RuntimeProtection.cs" Link="InstallerRuntimeProtection.cs" />
  </ItemGroup>
  <!-- The lab guard names the lab's real install and accepted account. Only a live-test build carries it, so the public build does not even compile the file. -->
  <ItemGroup Condition="'$(Installer)' == 'true' and '$(TestHooks)' == 'true'">
    <Compile Include="../installer/SoloStone.Launcher/LabGuard.cs" Link="InstallerLabGuard.cs" />
  </ItemGroup>
  <Target Name="ValidateInstaller" BeforeTargets="PrepareForBuild" Condition="'$(Installer)' == 'true'">
    <Error Condition="'$(StandardProof)' == 'true'" Text="Installer plugin cannot be a candidate build." />
  </Target>
  <PropertyGroup Condition="'$(StandardProof)' == 'true'">
    <DefineConstants>$(DefineConstants);STANDARD_PROOF</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ModernMechanics)' == 'true'">
    <DefineConstants>$(DefineConstants);MODERN_MECHANICS</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateStandardProofBuild" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EngineSource)' != 'true' and '$(StandardProof)' != 'true' and !Exists('$(SabberStoneCorePath)')" Text="No prebuilt engine at $(SabberStoneCorePath). Build with -p:EngineSource=true to compile the engine from source." />
    <Error Condition="'$(EngineSource)' == 'true' and '$(StandardProof)' == 'true'" Text="EngineSource=true cannot be combined with StandardProof=true." />
    <Error Condition="'$(ModernMechanics)' == 'true' and '$(StandardProof)' != 'true'" Text="ModernMechanics requires StandardProof=true." />
    <Error Condition="'$(ModernMechanics)' == 'true' and !$([System.String]::Copy(';$(DefineConstants);').Contains(';MODERN_MECHANICS;'))" Text="Modern build must define MODERN_MECHANICS." />
    <Error Condition="$([System.String]::Copy(';$(DefineConstants);').Contains(';MODERN_MECHANICS;')) and '$(ModernMechanics)' != 'true'" Text="MODERN_MECHANICS requires explicit ModernMechanics=true." />
    <Error Condition="$([System.String]::Copy('$(DefineConstants)').Contains('STANDARD_PROOF')) and '$(StandardProof)' != 'true'" Text="STANDARD_PROOF requires explicit StandardProof=true." />
    <Error Condition="'$(StandardProof)' == 'true' and !$([System.IO.Path]::IsPathRooted('$(SabberStoneCorePath)'))" Text="Candidate requires absolute engine path." />
    <Error Condition="'$(StandardProof)' == 'true' and !$([System.String]::Copy('$(DefineConstants)').Contains('STANDARD_PROOF'))" Text="Candidate build must define STANDARD_PROOF." />
    <Error Condition="'$(StandardProof)' == 'true' and !Exists('$(SabberStoneCorePath)')" Text="Candidate engine missing." />
    <Error Condition="'$(StandardProof)' == 'true' and !$([System.IO.Path]::IsPathRooted('$(OutputPath)'))" Text="Candidate requires isolated absolute output path." />
    <Error Condition="'$(StandardProof)' == 'true' and !$([System.IO.Path]::IsPathRooted('$(BaseIntermediateOutputPath)'))" Text="Candidate requires isolated absolute intermediates." />
  </Target>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExReferences)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExReferences)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameReferences)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameReferences)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameReferences)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameReferences)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameReferences)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(GameReferences)/UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.T5.MiniJSON"><HintPath>$(GameReferences)/Blizzard.T5.MiniJSON.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameReferences)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="blizzard.bgsclient"><HintPath>$(GameReferences)/blizzard.bgsclient.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="blizzard.bgssdk"><HintPath>$(GameReferences)/blizzard.bgssdk.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.T5.Core"><HintPath>$(GameReferences)/Blizzard.T5.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.T5.ServiceLocator"><HintPath>$(GameReferences)/Blizzard.T5.ServiceLocator.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.T5.JobQueue"><HintPath>$(GameReferences)/Blizzard.T5.JobQueue.dll</HintPath><Private>false</Private></Reference>
    <Reference Condition="'$(EngineSource)' != 'true'" Include="SabberStoneCore"><HintPath>$(SabberStoneCorePath)</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(EngineSource)' == 'true'">
    <ProjectReference Include="../engine/SabberStoneCore/SabberStoneCore.csproj" SetTargetFramework="TargetFramework=netstandard2.1" Private="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(StandardProof)' == 'true'">
    <Compile Condition="'$(ModernMechanics)' != 'true'" Include="../research/standard-proof/ProofDecks.cs" Link="ProofDecks.cs" />
    <Compile Condition="'$(ModernMechanics)' == 'true'" Include="../research/modern-mechanics/ProofDecks.cs" Link="ProofDecks.cs" />
    <EmbeddedResource Condition="'$(ModernMechanics)' == 'true'" Include="../research/modern-mechanics/definitions.json" LogicalName="StandardProofDefinitions.json" />
    <EmbeddedResource Condition="'$(ModernMechanics)' == 'true'" Include="../research/modern-mechanics/native-tags.json" LogicalName="ModernMechanicsNativeTags.json" />
    <Compile Include="../research/standard-proof/ProofBot.cs" Link="ProofBot.cs" />
    <EmbeddedResource Condition="'$(ModernMechanics)' != 'true'" Include="../research/standard-proof/definitions.json" LogicalName="StandardProofDefinitions.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="client-bindings.txt" LogicalName="client-bindings.txt" />
    <EmbeddedResource Include="../data/shop/catalog-v1.json" LogicalName="SoloStone.Shop.catalog-v1.json" />
    <EmbeddedResource Include="../data/pools/offline-standard-v1.json" LogicalName="SoloStone.Shop.active-pool.json" />
    <EmbeddedResource Include="../data/shop/recipes-v1.json" LogicalName="SoloStone.Shop.recipes-v1.json" />
  </ItemGroup>
  <!-- NPC World v1 data (docs/superpowers/specs/2026-10-25-npc-world-v1-design.md); read by NpcWorldBoot only. -->
  <ItemGroup>
    <EmbeddedResource Condition="'$(EngineSource)' != 'true'" Include="../engine/SabberStoneCore/resources/Data/OfflinePoolCatalog.xml" LogicalName="SoloStone.Npc.OfflinePoolCatalog.xml" />
    <EmbeddedResource Include="../data/npc/decks-v1.json" LogicalName="SoloStone.Npc.decks-v1.json" />
    <EmbeddedResource Include="../data/npc/casual-decks-v1.json" LogicalName="SoloStone.Npc.casual-decks-v1.json" />
    <EmbeddedResource Include="../data/npc/skills-v1.json" LogicalName="SoloStone.Npc.skills-v1.json" />
    <EmbeddedResource Include="../data/npc/personalities-v1.json" LogicalName="SoloStone.Npc.personalities-v1.json" />
    <EmbeddedResource Include="../data/npc/notables-v1.json" LogicalName="SoloStone.Npc.notables-v1.json" />
    <EmbeddedResource Include="../data/npc/names-v1.json" LogicalName="SoloStone.Npc.names-v1.json" />
    <EmbeddedResource Include="../data/npc/cosmetics-v1.json" LogicalName="SoloStone.Npc.cosmetics-v1.json" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../data/progression/card-mastery.json" LogicalName="SoloStone.Progression.card-mastery.json" />
  </ItemGroup>
</Project>
