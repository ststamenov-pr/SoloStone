<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the multiplayer core. They need the engine only: no game client, no Unity.
       Run from the repository root with: dotnet run -c Release, pointing the project option at tests/Multiplayer.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../plugin/Multiplayer/**/*.cs" LinkBase="Multiplayer" />
    <!-- The built-in AI the plugin already has; engine-only code. -->
    <Compile Include="../../plugin/LocalBot.cs" Link="LocalBot.cs" />
    <ProjectReference Include="../../engine/SabberStoneCore/SabberStoneCore.csproj"
                      SetTargetFramework="TargetFramework=net10.0" AdditionalProperties="GeneratePackageOnBuild=false" />
  </ItemGroup>
</Project>
